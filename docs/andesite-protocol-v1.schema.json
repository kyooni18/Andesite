    "applied": {
      "type": "object",
      "properties": {
        "status": {
          "const": "applied"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "$ref": "#/$defs/nullableUuid"
        },
        "sequence": {
          "$ref": "#/$defs/decimal"
        },
        "idempotencyExpiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "status",
        "operationId",
        "revision",
        "sequence",
        "idempotencyExpiresAt"
      ]
    },
    "conflictOutcome": {
      "type": "object",
      "properties": {
        "status": {
          "const": "conflict"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "conflictId": {
          "$ref": "#/$defs/uuid"
        },
        "submittedRevision": {
          "$ref": "#/$defs/nullableUuid"
        },
        "headRevision": {
          "$ref": "#/$defs/nullableUuid"
        },
        "sequence": {
          "$ref": "#/$defs/decimal"
        },
        "idempotencyExpiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "status",
        "error",
        "operationId",
        "conflictId",
        "submittedRevision",
        "headRevision",
        "sequence",
        "idempotencyExpiresAt"
      ]
    },
    "pending": {
      "type": "object",
      "properties": {
        "status": {
          "const": "pending"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "status",
        "operationId"
      ]
    },
    "notApplied": {
      "type": "object",
      "properties": {
        "status": {
          "const": "not_applied"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "idempotencyExpiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "status",
        "operationId",
        "error",
        "idempotencyExpiresAt"
      ]
    },
    "operationOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/applied"
        },
        {
          "$ref": "#/$defs/conflictOutcome"
        },
        {
          "$ref": "#/$defs/pending"
        },
        {
          "$ref": "#/$defs/notApplied"
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "$ref": "#/$defs/uuid"
        },
        "epoch": {
          "$ref": "#/$defs/uuid"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "required": [
        "snapshotId",
        "epoch",
        "expiresAt",
        "cursor"
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "entryId": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "revision": {
          "$ref": "#/$defs/uuid"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "size": {
          "$ref": "#/$defs/decimal"
        }
      },
      "required": [
        "entryId",
        "kind",
        "path",
        "revision",
        "contentHash",
        "size"
      ]
    },
    "conflict": {
      "type": "object",
      "properties": {
        "conflictId": {
          "$ref": "#/$defs/uuid"
        },
        "entryId": {
          "$ref": "#/$defs/uuid"
        },
        "operationId": {
          "$ref": "#/$defs/nullableUuid"
        },
        "intentType": {
          "enum": [
            "create",
            "update",
            "move",
            "delete",
            "restore",
            "resolve"
          ]
        },
        "baseRevision": {
          "$ref": "#/$defs/nullableUuid"
        },
        "observedHead": {
          "$ref": "#/$defs/nullableUuid"
        },
        "requestedPath": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "submittedRevision": {
          "$ref": "#/$defs/nullableUuid"
        },
        "contentHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "resolvedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contentHash": {
                "$ref": "#/$defs/hash"
              },
              "size": {
                "$ref": "#/$defs/decimal"
              },
              "role": {
                "enum": ["preimage", "observed", "recovery"]
              }
            },
            "required": ["contentHash", "size", "role"]
          }
        }
      },
      "required": [
        "conflictId",
        "entryId",
        "operationId",
        "intentType",
        "baseRevision",
        "observedHead",
        "requestedPath",
        "submittedRevision",
        "contentHash",
        "size",
        "status",
        "createdAt",
        "resolvedAt"
      ]
    },
    "entryPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "maxItems": 500
        },
        "nextPage": {
          "type": [
            "string",
