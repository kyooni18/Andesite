{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andesite.invalid/protocol/v1.schema.json",
  "title": "Andesite sync v1 named wire schemas",
  "$comment": "Planned HTTP/sync contract, not an implemented listener. Select #/$defs/<name>; semantic validation is also required. snapshot/snapshotPending describe full-vault sync manifests, NOT the implemented CLI's individual-file recovery snapshots; see andesite-file-recovery.md. A limited same-user read-only Unix-socket recovery-snapshot API is implemented separately from the planned v1 network/sync contract.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{103}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "markdown",
        "attachment"
      ]
    },
    "nullableUuid": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "write"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "contentHash": {
              "$ref": "#/$defs/hash"
            },
            "size": {
              "$ref": "#/$defs/decimal"
            }
          },
          "required": [
            "action",
            "path",
            "contentHash",
            "size"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "delete"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "keep_head"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      ]
    },
    "operationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "clientId": {
              "$ref": "#/$defs/uuid"
            },
            "operationId": {
              "$ref": "#/$defs/uuid"
            },
            "entryId": {
              "$ref": "#/$defs/uuid"
            },
            "baseRevision": {
              "type": "null"
            },
            "type": {
              "const": "create"
            },
            "kind": {
              "$ref": "#/$defs/kind"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "contentHash": {
              "$ref": "#/$defs/hash"
            },
            "size": {
              "$ref": "#/$defs/decimal"
            }
          },
          "required": [
            "clientId",
            "operationId",
            "entryId",
            "baseRevision",
            "type",
            "kind",
            "path",
            "contentHash",
            "size"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clientId": {
              "$ref": "#/$defs/uuid"
            },
            "operationId": {
              "$ref": "#/$defs/uuid"
            },
            "entryId": {
              "$ref": "#/$defs/uuid"
            },
            "baseRevision": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "update"
            },
            "contentHash": {
              "$ref": "#/$defs/hash"
            },
            "size": {
              "$ref": "#/$defs/decimal"
            }
          },
          "required": [
            "clientId",
            "operationId",
            "entryId",
            "baseRevision",
            "type",
            "contentHash",
            "size"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clientId": {
              "$ref": "#/$defs/uuid"
            },
            "operationId": {
              "$ref": "#/$defs/uuid"
            },
            "entryId": {
              "$ref": "#/$defs/uuid"
            },
            "baseRevision": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "move"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "clientId",
            "operationId",
            "entryId",
            "baseRevision",
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clientId": {
              "$ref": "#/$defs/uuid"
            },
            "operationId": {
              "$ref": "#/$defs/uuid"
            },
            "entryId": {
              "$ref": "#/$defs/uuid"
            },
            "baseRevision": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "delete"
            }
          },
          "required": [
            "clientId",
            "operationId",
            "entryId",
            "baseRevision",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clientId": {
              "$ref": "#/$defs/uuid"
            },
            "operationId": {
              "$ref": "#/$defs/uuid"
            },
            "entryId": {
              "$ref": "#/$defs/uuid"
            },
            "baseRevision": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "restore"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "contentHash": {
              "$ref": "#/$defs/hash"
            },
            "size": {
              "$ref": "#/$defs/decimal"
            }
          },
          "required": [
            "clientId",
            "operationId",
            "entryId",
            "baseRevision",
            "type",
            "path",
            "contentHash",
            "size"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clientId": {
              "$ref": "#/$defs/uuid"
            },
            "operationId": {
              "$ref": "#/$defs/uuid"
            },
            "entryId": {
              "$ref": "#/$defs/uuid"
            },
            "baseRevision": {
              "$ref": "#/$defs/nullableUuid"
            },
            "type": {
              "const": "resolve"
            },
            "conflictId": {
              "$ref": "#/$defs/uuid"
            },
            "resolution": {
              "$ref": "#/$defs/resolution"
            }
          },
          "required": [
            "clientId",
            "operationId",
            "entryId",
            "baseRevision",
            "type",
            "conflictId",
            "resolution"
          ],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
